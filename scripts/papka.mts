/**
 * Папка для проверяющего: всё о модуле в одном месте, без кода.
 *
 * ЗАЧЕМ. Приёмка одного модуля стоила 250–320 тысяч токенов: методист читал
 * файл модуля целиком — полторы тысячи строк, где вперемешку служебные
 * комментарии, английский, русский и код, — потом сам разбирал PDF, искал по
 * словнику на пять тысяч строк и руками строил таблицу «задание → блок».
 *
 * Из четырёх дел только одно — открыть источник и привести цитату — настоящая
 * работа проверяющего. Остальное у нас уже написано и считается за секунду.
 *
 * ЧЕГО ЭТА ПАПКА НЕ ДЕЛАЕТ. Она не заменяет доступ к источникам. Вся ценность
 * методиста в том, что он открывает файл и приводит цитату: так поймали `will`
 * в графе A2 Flyers и `How much` на B1 — этого не умеет ни один скрипт. Папка
 * снимает беготню за материалом, а не проверку.
 *
 * И отчёт скриптов — не истина, а разобранное. Проверяющему это сказано прямо
 * в шапке папки, иначе он начнёт с отчётом соглашаться.
 *
 * Запуск:  npm run papka -- english-starter alfavit
 */
import { execFileSync } from "node:child_process";
import { mkdirSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { courses } from "../courses/index.ts";

const [kurs, modul] = process.argv.slice(2);

if (!kurs || !modul) {
  console.error("Как звать: npm run papka -- english-starter alfavit");
  process.exit(1);
}

const course = courses.find((c) => c.slug === kurs);
if (!course) {
  console.error(`Курса «${kurs}» нет. Есть: ${courses.map((c) => c.slug).join(", ")}`);
  process.exit(1);
}

const nomer = course.modules.findIndex((m) => m.slug === modul);
if (nomer < 0) {
  console.error(`В курсе нет модуля «${modul}».`);
  process.exit(1);
}

const mod = course.modules[nomer];
const papka = join(".papka", `${kurs}-${modul}`);
mkdirSync(papka, { recursive: true });

/** Запустить наш же скрипт и забрать вывод. Ошибку не глотаем: пустой файл хуже отсутствующего. */
function skript(imya: string, args: string[]): string {
  try {
    return execFileSync("npx", ["tsx", `scripts/${imya}.mts`, ...args], {
      encoding: "utf8",
      maxBuffer: 64 * 1024 * 1024,
      shell: process.platform === "win32",
    });
  } catch (e: any) {
    // Скрипты проверок возвращают ненулевой код при находках — это не поломка.
    return (e.stdout ?? "") + (e.stderr ? `\n[ошибки запуска]\n${e.stderr}` : "");
  }
}

const shapka = `# Модуль ${nomer + 1}. ${mod.title}

Курс: ${course.title} (${kurs}), имя модуля: \`${modul}\`.
Уроков: ${mod.lessons.length}, вопросов в работе: ${mod.quiz.questions.length}.

## Как этим пользоваться

В папке лежит всё, что нужно для разбора, **без кода**:

| Файл | Что внутри |
|---|---|
| \`tekst.md\` | урок глазами ученика: объяснения, таблицы, примеры |
| \`zadaniya.txt\` | все задания и вся проверочная работа: условия, варианты, подсказки, разборы |
| \`istochniki.md\` | поле \`sources\` модуля целиком |
| \`kontrol.txt\` | сверка цитат с источниками и таблица «задание → блок» |
| \`yazyk.txt\` | механические проверки русского языка |
| \`proverki.txt\` | что общие проверки нашли в этом модуле — в том числе ВОПРОСЫ, которые решать тебе |

**Что уже проверено машиной — не перепроверяй:**

- каждая цитата из \`sources\` найдена в самих материалах (или прямо сказано, что не нашлась);
- построена таблица «задание → блок, на который оно опирается»;
- задание, требующее слова раньше словаря, найдено;
- пустые ответы, повторы вариантов, покрытие итогов, распределение верных ответов;
- кальки, родовое прошедшее время, склонение при числах, знаки транскрипции.

**Что машина не умеет и остаётся тебе:**

- верна ли цитата ДЛЯ ТОГО УТВЕРЖДЕНИЯ, рядом с которым стоит (цитата из соседней графы таблицы выглядит настоящей);
- не врёт ли шапка о ступени — скрипт сверяет цитаты, но не полноту списка;
- задание, наказывающее за верный ответ;
- неверный вариант, который никто никогда не написал бы;
- понятность объяснения ученику.

**Отчёт скриптов — не истина, а разобранное.** Если он молчит, это не значит,
что всё верно: он проверяет только перечисленное выше. Если он говорит
«не нашёл» — это не «нет».

**К источникам возвращайся только там, где нужно уточнение.** Открывать их
подряд незачем: цитаты уже сверены. Открывай, когда что-то в тексте вызывает
сомнение — тогда обязательно, с точной цитатой.
`;

writeFileSync(join(papka, "README.md"), shapka, "utf8");
writeFileSync(
  join(papka, "istochniki.md"),
  `# Источники модуля «${mod.title}»\n\n` +
    mod.sources
      .map((s) => `## ${s.ref}\n\n${s.section ?? "(раздел не указан)"}\n\n_${s.license ?? ""}_\n`)
      .join("\n"),
  "utf8"
);
// tekst ждёт имя модуля, а не номер: с номером он молча отдаёт пустоту.
writeFileSync(join(papka, "tekst.md"), skript("tekst", [kurs, modul]), "utf8");
writeFileSync(join(papka, "zadaniya.txt"), skript("zadaniya", [kurs, modul]), "utf8");
writeFileSync(join(papka, "kontrol.txt"), skript("kontrol", [kurs, modul]), "utf8");
writeFileSync(join(papka, "yazyk.txt"), skript("yazyk", [kurs]), "utf8");

/*
 * Отчёт общих проверок — только та его часть, что относится к этому модулю.
 *
 * Нужен из-за проверки перекличек с уроками: она даёт не ошибки, а ВОПРОСЫ
 * («вопрос работы построен на том же примере, что задание урока»), а решить их
 * может только методист. Без этого файла он о них не узнаёт: отчёт печатается
 * сразу по всему курсу и в папку не попадал.
 */
// Двоеточие в конце обязательно: без него сюда попадал список заготовок записи
// — по строке на каждый урок, ни одного слова о содержании.
const zagolovok = new RegExp(`^\\s*[·✗]\\s${kurs} → ${modul}\\b.*: `);
const nachaloBloka = /^\s*[·✗]\s/;
const stroki = skript("check-content", []).split(/\r?\n/);
const nashi: string[] = [];
let beryom = false;
for (const stroka of stroki) {
  if (nachaloBloka.test(stroka)) beryom = zagolovok.test(stroka);
  if (beryom) nashi.push(stroka);
}
writeFileSync(
  join(papka, "proverki.txt"),
  nashi.length > 0
    ? `Что общие проверки говорят об этом модуле:\n\n${nashi.join("\n")}\n`
    : "Общие проверки по этому модулю молчат.\n\nЭто не значит, что всё верно: они проверяют только перечисленное в README.\n",
  "utf8"
);

console.log(`Папка собрана: ${papka}`);
console.log("Файлы: README.md, tekst.md, zadaniya.txt, istochniki.md, kontrol.txt, yazyk.txt");
