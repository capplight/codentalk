/**
 * Проверка русского языка в текстах, которые видит ученик.
 *
 * Половина находок редактора повторяется из модуля в модуль и вся механическая:
 * кальки, родовое прошедшее время при обращении на «ты», знаки транскрипции не
 * той условности. Это уходит сюда, чтобы у редактора освободился ход на то,
 * ради чего его и звали: понятность, тон, связность.
 *
 * УСТРОЙСТВО. Три уровня (см. scripts/otchyot.mts) и одно правило поверх них:
 * проверка обязана понимать, где она смотрит. Слово `вы` внутри объяснения о
 * том, что английское `you` переводится и «ты», и «вы», — не нарушение
 * обращения. Число в предложном обороте «в 5 уроке» склоняется не так, как в
 * счётном «5 уроков». Где проверка не может отличить одно от другого, она
 * говорит ВОПРОС, а не ОШИБКА.
 *
 * Запуск:
 *   npm run yazyk                                весь курс
 *   npm run yazyk -- english-starter             один курс
 *   npm run yazyk -- english-starter ya-ne-delayu   один модуль
 */
import { courses } from "../courses/index.ts";
import { kuskiModulya, type Kusok } from "./vidimoe.mts";
import { otchyot, proveritResheno, skazat } from "./otchyot.mts";

// ---------------------------------------------------------------------------
// 1. Кальки с английского
//
// Список ровно тот, что записан владельцем в CLAUDE.md, — своего сюда не
// добавлено намеренно. Он проверяет эти тексты сам, и лишнее слово в списке
// означало бы спор с ним в каждом модуле.
// ---------------------------------------------------------------------------

/**
 * ВНИМАНИЕ НА ГРАНИЦЫ СЛОВА. `\b` и `\w` в JavaScript считают буквой только
 * латиницу, поэтому `/\bдедлайн/` не находит «дедлайн» никогда: перед `д`
 * стоит пробел, и оба знака для `\b` одинаково «не буквы». Проверка молчала,
 * и отчёт выглядел чистым. Границы задаём разбором вручную.
 */
const RUS = "а-яёА-ЯЁ";
const kalka = (stem: string): RegExp => new RegExp(`(?<![${RUS}])${stem}[${RUS}]*`, "i");

const KALKI: Array<[RegExp, string]> = [
  [kalka("стрик"), "счётчик дней"],
  [kalka("дрип[- ]?контент"), "открытие материалов по расписанию"],
  [kalka("онбординг"), "первые шаги"],
  [kalka("гейт"), "ограничение доступа"],
  [kalka("эндпоинт"), "метод интерфейса"],
  [kalka("дедлайн"), "срок"],
  [kalka("фич[ауеиой]"), "возможность"],
  [kalka("юзер"), "ученик"],
  [kalka("чекн"), "проверить"],
  [kalka("(?:за)?деплой"), "выложить"],
  // Вторая половина списка — из определения редактора, где он длиннее.
  [kalka("кейс"), "случай"],
  [kalka("воркфлоу"), "порядок работы"],
  [kalka("челлендж"), "испытание"],
  [kalka("ассессмент"), "проверка знаний"],
  [kalka("инсайт"), "наблюдение"],
  [kalka("скилл"), "умение"],
];

function proveritKalki(k: Kusok): void {
  for (const [obrazec, chem] of KALKI) {
    const hit = k.text.match(obrazec);
    if (hit) {
      skazat("ОШИБКА", k.gde, `калька «${hit[0]}» в тексте для ученика (${k.rol})`,
        `по-русски это «${chem}»`);
    }
  }
}

// ---------------------------------------------------------------------------
// 2. Прошедшее время при обращении на «ты»
//
// Обращение к ученику — «ты», решение владельца. Из этого следует правило,
// которое очень легко нарушить: прошедшее время во втором лице родовое («ты
// прошёл» или «ты прошла»), а пола ученика платформа не знает.
//
// Ищем только ЕДИНСТВЕННОЕ число: «ты прошли» не бывает, а «мы разобрали» на
// -ли рода не требует и беды не составляет. Это и делает проверку тихой.
// ---------------------------------------------------------------------------

/**
 * Родовые формы прошедшего времени — списком, а не образцом.
 *
 * Образец «слово кончается на -л» кажется очевидным и не работает: на -л
 * кончаются футбол, глагол, стол, угол, сигнал, журнал. На первом же прогоне
 * проверка выдала три замечания, и все три были ложными. На -ла не лучше:
 * школа, скала, игла.
 *
 * Поэтому список настоящих глаголов, которые вправду встречаются в таких
 * текстах. Он заведомо неполон — и это правильный выбор: пропущенный глагол
 * найдёт редактор, а ложное замечание отучит читать отчёт целиком. Встретил
 * непойманный — допиши сюда.
 */
const GLAGOLY = new Set<string>();
for (const [muzh, zhen] of [
  ["был", "была"], ["стал", "стала"], ["смог", "смогла"], ["сделал", "сделала"],
  ["делал", "делала"], ["прошёл", "прошла"], ["прошел", "прошла"], ["выучил", "выучила"],
  ["узнал", "узнала"], ["увидел", "увидела"], ["видел", "видела"], ["услышал", "услышала"],
  ["слышал", "слышала"], ["писал", "писала"], ["написал", "написала"], ["читал", "читала"],
  ["прочитал", "прочитала"], ["взял", "взяла"], ["начал", "начала"], ["закончил", "закончила"],
  ["запомнил", "запомнила"], ["забыл", "забыла"], ["ответил", "ответила"], ["отвечал", "отвечала"],
  ["встретил", "встретила"], ["получил", "получила"], ["набрал", "набрала"], ["сдал", "сдала"],
  ["открыл", "открыла"], ["разобрал", "разобрала"], ["повторил", "повторила"],
  ["потерял", "потеряла"], ["попал", "попала"], ["сказал", "сказала"], ["нашёл", "нашла"],
  ["нашел", "нашла"], ["понял", "поняла"], ["решил", "решила"], ["пришёл", "пришла"],
  ["ушёл", "ушла"], ["пропустил", "пропустила"], ["заметил", "заметила"], ["выбрал", "выбрала"],
  ["поставил", "поставила"], ["записал", "записала"], ["назвал", "назвала"],
  ["справился", "справилась"], ["ошибся", "ошиблась"], ["догадался", "догадалась"],
  ["научился", "научилась"], ["познакомился", "познакомилась"], ["вернулся", "вернулась"],
  ["остановился", "остановилась"], ["собрал", "собрала"], ["перевёл", "перевела"],
  // Дописано после модуля 16: скрипт пропустил «ты уже ставил» и «ты уже
  // встречал», нашёл редактор. Список пополняется, и это его обычная жизнь.
  ["ставил", "ставила"], ["встречал", "встречала"], ["брал", "брала"],
  ["давал", "давала"], ["учил", "учила"], ["помнил", "помнила"],
  ["думал", "думала"], ["хотел", "хотела"], ["мог", "могла"], ["шёл", "шла"],
  ["ходил", "ходила"], ["говорил", "говорила"], ["спрашивал", "спрашивала"],
  ["считал", "считала"], ["называл", "называла"], ["менял", "меняла"],
  ["пробовал", "пробовала"], ["пытался", "пыталась"], ["оказался", "оказалась"],
  ["остался", "осталась"], ["начинал", "начинала"], ["узнавал", "узнавала"],
  ["проходил", "проходила"], ["проверял", "проверяла"], ["замечал", "замечала"],
  ["выбирал", "выбирала"], ["слушал", "слушала"], ["смотрел", "смотрела"],
  ["находил", "находила"], ["слышал", "слышала"], ["ел", "ела"],
  // Дописано после модуля 25: редактор нашёл «ты работал» и «ты провёл» —
  // обоих глаголов в списке не было, а модуль как раз о прошедшем времени.
  ["работал", "работала"], ["провёл", "провела"], ["отдыхал", "отдыхала"],
  ["гулял", "гуляла"], ["играл", "играла"], ["жил", "жила"],
  ["учился", "училась"], ["купил", "купила"], ["приходил", "приходила"],
  ["уехал", "уехала"], ["поехал", "поехала"], ["встал", "встала"],
]) {
  GLAGOLY.add(muzh);
  GLAGOLY.add(zhen);
}

function proveritProshedshee(k: Kusok): void {
  if (!/[а-яё]/i.test(k.text)) return;

  // По предложениям, а не по всему куску: «ты» и его глагол стоят в одном
  // предложении. Без этого склеенная строка таблицы дала ложное «ты … ошибся» —
  // «Ты не прав.» в одной ячейке, «собеседник ошибся» в соседней.
  for (const predlozhenie of k.text.split(/[.!?|\n]+/)) {
    const slova = predlozhenie.split(/\s+/);
    for (let i = 0; i < slova.length; i++) {
      const chistoe = slova[i].replace(/[^а-яё]/gi, "");
      if (chistoe.toLowerCase() !== "ты") continue;

      // «Обращение на „ты“», «you — это „ты“ или „вы“»: слово названо, а не
      // употреблено. В кавычках оно ни к какому глаголу не относится.
      if (/[«„"]\s*ты|ты\s*[»“"]/i.test(slova[i])) continue;

      for (let j = i + 1; j < Math.min(slova.length, i + 7); j++) {
        const glagol = slova[j].replace(/[^а-яё]/gi, "").toLowerCase();
        if (!GLAGOLY.has(glagol)) continue;
        const daleko = j - i > 2;
        skazat(
          daleko ? "ВОПРОС" : "ОШИБКА",
          k.gde,
          `«ты … ${glagol}» — прошедшее время во втором лице (${k.rol})`,
          daleko
            ? "проверь, к «ты» ли относится глагол: если да, форма выдаёт пол ученика, а платформа его не знает"
            : "форма родовая, а пола ученика платформа не знает — перепиши настоящим временем " +
              "или безличным оборотом: не «ты прошёл всё», а «все взятые уроки пройдены»"
        );
        break;
      }
    }
  }
}

// ---------------------------------------------------------------------------
// 2а. Краткое прилагательное при «ты» — та же беда, другая часть речи
//
// Нашёл редактор в модуле 18: «ты сейчас занят другим». Прошедшее время скрипт
// ловил, а «занят» пропускал — хотя пол ученика оно выдаёт ровно так же.
//
// Список, а не образец, и по той же причине, что у глаголов: на «-ен»
// кончается «современен», на «-ов» — «готов» и «зов». Проверка идёт тем же
// окном по предложению со словом «ты».
// ---------------------------------------------------------------------------

const KRATKIE = new Set<string>();
for (const [muzh, zhen] of [
  ["занят", "занята"], ["готов", "готова"], ["должен", "должна"],
  ["рад", "рада"], ["уверен", "уверена"], ["свободен", "свободна"],
  ["согласен", "согласна"], ["болен", "больна"], ["голоден", "голодна"],
  ["доволен", "довольна"], ["знаком", "знакома"], ["похож", "похожа"],
  ["способен", "способна"], ["внимателен", "внимательна"],
  ["спокоен", "спокойна"], ["счастлив", "счастлива"], ["устал", "устала"],
  ["привык", "привыкла"], ["уверён", "уверена"],
  // Дописано после модуля 22: редактор нашёл «дело будешь делать ты сам».
  // Слово «сам» — не прилагательное, но род выдаёт ровно так же.
  ["сам", "сама"],
  // «прав» и «права» намеренно не взяты: «права» — ещё и множественное число
  // слова «право», а «ты не прав» встречается в курсе как перевод примера.
  // Ложное замечание здесь дороже пропуска.
]) {
  KRATKIE.add(muzh);
  KRATKIE.add(zhen);
}

function proveritKratkoe(k: Kusok): void {
  if (!/[а-яё]/i.test(k.text)) return;

  for (const predlozhenie of k.text.split(/[.!?|\n]+/)) {
    const slova = predlozhenie.split(/\s+/);
    for (let i = 0; i < slova.length; i++) {
      const chistoe = slova[i].replace(/[^а-яё]/gi, "");
      if (chistoe.toLowerCase() !== "ты") continue;
      if (/[«„"]\s*ты|ты\s*[»“"]/i.test(slova[i])) continue;

      for (let j = i + 1; j < Math.min(slova.length, i + 7); j++) {
        const slovo = slova[j].replace(/[^а-яё]/gi, "").toLowerCase();
        if (!KRATKIE.has(slovo)) continue;
        const daleko = j - i > 2;
        skazat(
          daleko ? "ВОПРОС" : "ОШИБКА",
          k.gde,
          `«ты … ${slovo}» — краткое прилагательное во втором лице (${k.rol})`,
          daleko
            ? "проверь, к «ты» ли оно относится: если да, форма выдаёт пол ученика"
            : "форма родовая, а пола ученика платформа не знает — перепиши глаголом " +
              "настоящего времени: не «ты занят другим», а «ты делаешь что-то другое»"
        );
        break;
      }
    }
  }
}

// ---------------------------------------------------------------------------
// 3. Единое обращение — через повелительное наклонение, а не через «вы»
//
// Искать местоимение «вы» бесполезно, и это выяснилось опытом: одиннадцать
// замечаний на курсе, и все ложные. Пять — переводы слова `your` («ваш» там и
// есть значение). Остальные шесть — включающее «вы», то есть «ты и
// собеседник»: «сумка, которую вы оба видите», «занятие у вас одно». Это
// правильный русский, и отличить его от вежливого обращения машина не может.
//
// А вот повелительное наклонение во множественном числе двусмысленным не
// бывает: «выберите» вместо «выбери» — это сбой обращения и ничего больше.
// Список, а не образец: на «-ите» кончается и «в защите», на «-йте» — «на
// сайте».
// ---------------------------------------------------------------------------

const POVELENIE = new Set([
  "выберите", "напишите", "нажмите", "послушайте", "прочитайте", "отметьте",
  "соберите", "вставьте", "сравните", "повторите", "посмотрите", "запишите",
  "произнесите", "ответьте", "допишите", "перестройте", "скажите", "назовите",
  "поставьте", "исправьте", "расставьте", "заполните", "составьте", "проверьте",
  "переведите", "закройте", "откройте", "возьмите", "помните", "обратите",
]);

function proveritPovelenie(k: Kusok): void {
  for (const slovo of k.text.split(/\s+/)) {
    const chistoe = slovo.replace(new RegExp(`[^${RUS}]`, "g"), "").toLowerCase();
    if (!POVELENIE.has(chistoe)) continue;
    skazat("ОШИБКА", k.gde, `«${chistoe}» — повелительное наклонение на «вы» (${k.rol})`,
      "к ученику курс обращается на «ты»: «выбери», «напиши», «отметь»");
  }
}

// ---------------------------------------------------------------------------
// 3а. Названия, о которых курс уже договорился
//
// Самая дорогая порода этого проекта: в новом модуле у знакомой вещи заводится
// второе имя. Владелец споткнулся об это лично — модуль 11 звал прилагательное
// «признаком», и признак предмету присущ, а `hot` и `busy` говорят о состоянии.
// Модуль переписали, а в модуле 16 ярлык вернулся — и к тому же слову `busy`.
//
// Здесь только те названия, о которых уже есть решение. Спорное сюда не
// попадает: «краткий» против «короткого» ответа в курсе пока живут оба, и
// молчать об этом честнее, чем объявлять ошибкой одно из двух.
// ---------------------------------------------------------------------------

const NAZVANIYA: Array<["ОШИБКА" | "ВОПРОС", RegExp, string, string]> = [
  ["ОШИБКА", kalka("признак"), "признак",
    "прилагательное называется прилагательным: признак предмету присущ, а busy и hot " +
    "говорят о состоянии. Решение владельца после модуля 11"],
  // «Первое слово вопроса», «два слова вопроса идут вместе» — это обычная речь
  // о порядке слов, и она законна. Ярлыком оборот становится без счётного слова
  // перед ним: «слово вопроса ставят одно и в самом начале». Различаем счётом —
  // иначе проверка ругается на пять правильных мест в модулях 6, 7 и 9.
  ["ОШИБКА", /(?<!перв[оы][ем]\s)(?<!втор[оы][ем]\s)(?<!треть[еи][ем]\s)(?<!два\s)(?<!последн[еи][ем]\s)(?<!кажд[оы][ем]\s)слов[оаеуы]м?\s+вопроса/i,
    "слово вопроса",
    "курс уже говорит «вопросительное слово» — модули «Что это такое» и «Числа, " +
    "возраст, цена». А do и does лучше не называть никак: «Do в начале вопроса»"],
  // Не «тот, о ком спрашивают», а любое «о ком спрашива…»: сплошная замена
  // прошла по точному обороту и оставила «после того, о ком спрашиваешь».
  // Нашёл редактор. Частичная замена — обычный исход сплошной правки, и ловить
  // её надо образцом пошире.
  // Настоящее время: ярлыком оборот бывает только в нём. «Не о том, о ком
  // спрашивали» в модуле 4 — обычная речь о прошлом разговоре, и трогать её не
  // за что.
  ["ВОПРОС", /о ком спрашива(ют|ешь|ем)/i, "о ком спрашивают",
    "курс говорит «тот, о ком речь» и «тот, кто действует» — третье имя тому же месту " +
    "лишнее. И здесь оно двусмысленно: в Do you know Dana? спрашивают о Dana"],
  ["ВОПРОС", /в простом виде|глагол прост[оыа]|остаётся простым/i, "простой глагол",
    "о глаголе курс говорит «без окончания» — модуль «Я не делаю». Слово «простой» " +
    "к тому же скоро понадобится для настоящего простого времени"],
];

function proveritNazvaniya(k: Kusok): void {
  for (const [uroven, obrazec, chto, sovet] of NAZVANIYA) {
    if (obrazec.test(k.text)) skazat(uroven, k.gde, `«${chto}» — второе имя знакомой вещи (${k.rol})`, sovet);
  }
}

// ---------------------------------------------------------------------------
// 3б. Слова, которые унижают ученика
//
// «Просто», «легко», «очевидно»: если ученику непонятно, эти слова говорят ему,
// что беда в нём. Правило записано в определении редактора, а значит его место
// в скрипте — проверять такое агентом накладно и ненадёжно.
// ---------------------------------------------------------------------------

/**
 * Ищем не слово, а утверждение о лёгкости. Разница видна на живых примерах
 * курса: «легко перепутать», «легко описаться», «легко потерять артикль» — это
 * предупреждение, и оно ученику помогает. А «проверить просто» и «просто
 * запомнить» говорят ему, что дело пустяковое, — и если не вышло, виноват он.
 *
 * Первая редакция ловила слово целиком и выдала шестнадцать замечаний, из
 * которых настоящими были два.
 */
const UNIZHENIE = [
  /(?<![а-яё])(это|всё|все|тут|здесь)\s+просто(?![а-яё])/i,
  /(?<![а-яё])просто\s+(запомнить|понять|выучить|увидеть|сказать|сделать)(?![а-яё])/i,
  /(?<![а-яё])(проверить|запомнить|понять|сделать|сказать|разобраться)\s+просто(?![а-яё])/i,
  /(?<![а-яё])легко\s+(запомнить|понять|выучить|увидеть)(?![а-яё])/i,
  /(?<![а-яё])очевидно(?![а-яё])/i,
];

function proveritUnizhenie(k: Kusok): void {
  for (const obrazec of UNIZHENIE) {
    const hit = k.text.match(obrazec);
    if (!hit) continue;
    skazat("ВОПРОС", k.gde, `«${hit[0]}» — утверждение о лёгкости (${k.rol})`,
      "если у ученика не вышло, такое слово говорит ему, что беда в нём — убери или замени");
  }
}

// ---------------------------------------------------------------------------
// 4. Склонение при числах
//
// Только те слова, что вправду встречаются в курсе рядом с числом. Общего
// правила тут нет: чтобы склонять что угодно, нужен словарь форм, а без него
// проверка начнёт спорить с каждым вторым предложением.
// ---------------------------------------------------------------------------

/** [одна штука, две штуки, пять штук] */
const SCHYOT: Array<[string, string, string]> = [
  ["урок", "урока", "уроков"],
  ["модуль", "модуля", "модулей"],
  ["слово", "слова", "слов"],
  ["буква", "буквы", "букв"],
  ["задание", "задания", "заданий"],
  ["вопрос", "вопроса", "вопросов"],
  ["минута", "минуты", "минут"],
  ["час", "часа", "часов"],
  ["попытка", "попытки", "попыток"],
  ["балл", "балла", "баллов"],
  ["день", "дня", "дней"],
  ["звук", "звука", "звуков"],
  ["предложение", "предложения", "предложений"],
  ["пример", "примера", "примеров"],
  ["ошибка", "ошибки", "ошибок"],
];

/** Предлоги, после которых число с существительным стоят в своём падеже. */
const PREDLOGI = /\b(в|во|на|о|об|к|ко|по|за|с|со|из|от|до|при|под|над|про|у)\s*$/i;

function nuzhnaya(n: number): 0 | 1 | 2 {
  const sto = n % 100;
  if (sto >= 11 && sto <= 14) return 2;
  const ed = n % 10;
  if (ed === 1) return 0;
  if (ed >= 2 && ed <= 4) return 1;
  return 2;
}

function proveritSchyot(k: Kusok): void {
  for (const m of k.text.matchAll(/(\d+)\s+([а-яё]+)/gi)) {
    const chislo = Number(m[1]);
    if (!Number.isFinite(chislo)) continue;
    const slovo = m[2].toLowerCase();

    const stroka = SCHYOT.find((f) => f.includes(slovo));
    if (!stroka) continue;

    // «в 5 уроке», «на 2 странице» — падеж задаёт предлог, а не счёт.
    if (PREDLOGI.test(k.text.slice(0, m.index!))) continue;

    const nado = stroka[nuzhnaya(chislo)];
    if (slovo === nado) continue;
    skazat("ВОПРОС", k.gde, `«${chislo} ${slovo}» — по счёту нужно «${chislo} ${nado}» (${k.rol})`,
      "если это не счёт, а падеж после предлога, замечание ложное — проверь глазами");
  }
}

// ---------------------------------------------------------------------------
// 5. Условности записи транскрипции
//
// Все четыре решены и записаны в CLAUDE.md. Расхождение внутри курса хуже
// неудачно выбранного знака: таблицы модулей разойдутся, и ученик увидит два
// разных написания одного звука.
//
// Разница уровней здесь настоящая, а не для красоты: первые три условности
// владелец подтвердил, последние две ждут его слова — значит вопрос, а не
// ошибка.
// ---------------------------------------------------------------------------

const ZNAKI: Array<[RegExp, string, string]> = [
  [/ɛ/, "ɛ", "курс пишет краткий гласный через `e`: /ef/, /el/, /spel/"],
  [/ɹ/, "ɹ", "курс пишет согласный как `r`, а не `ɹ`"],
  // Знак `ɡ` — не обычная буква g, а отдельный знак латиницы (U+0261). На вид
  // они почти неразличимы, поэтому условность из CLAUDE.md полтора десятка
  // модулей держалась только на внимании автора и не удержалась: к тому дню,
  // когда проверку дописали, в курсе стояло 36 записей со знаком и ни одной
  // жалобы. Ровно тот случай, ради которого механическое уходит в скрипт.
  [/ɡ/, "ɡ", "курс пишет согласный обычной буквой `g`: /gɪˈtɑː/"],
  [/ɐ/, "ɐ", "безударный гласный на конце курс пишет через `ə`: /ˈtiːtʃə/"],
  [/əː/, "əː", "безударный гласный на конце курс пишет через `ə`, без долготы"],
];

/**
 * Пятая условность — слоговой согласный без `ə` (`/ˈæpl/`, а не `ˈæpəl`) —
 * проверкой быть не может, и это выяснилось опытом.
 *
 * Образец «ə перед конечным l или n» ловит `/ˈwʊmən/`, `/ˈəʊpən/`, `/ən/` —
 * а это обычные словарные записи, где гласный на месте. Отличить их от `ˈæpəl`
 * без словаря нельзя: разница лексическая, а не звуковая. Шесть замечаний на
 * первом же прогоне, и все ложные.
 *
 * Поэтому вместо обвинения — список: все такие записи курса в одной строке.
 * Глазу видно за секунду, разошлись они или нет, а скрипт ни на что не
 * притязает. Тем более что и сама условность ждёт подтверждения владельца.
 */
const slogovye = new Set<string>();

function proveritZnaki(k: Kusok): void {
  const gde = k.rol === "произношение" ? k.text : (k.text.match(/\/[^/]+\//g) ?? []).join(" ");
  if (!gde) return;
  for (const [obrazec, chto, sovet] of ZNAKI) {
    if (obrazec.test(gde)) skazat("ОШИБКА", k.gde, `в транскрипции «${gde.trim()}» стоит ${chto}`, sovet);
  }
  for (const zapis of gde.match(/\/[^/]*ə[ln]\//g) ?? []) slogovye.add(zapis);
}

// ---------------------------------------------------------------------------
// Ход проверки
// ---------------------------------------------------------------------------

proveritResheno();

const [, , kursSlug, modulSlug] = process.argv;

for (const course of courses) {
  if (kursSlug && course.slug !== kursSlug) continue;
  console.log(`\n=== ${course.title} (${course.slug})`);

  for (const mod of course.modules) {
    if (modulSlug && mod.slug !== modulSlug) continue;
    const { kuski, poteryano } = kuskiModulya(mod);

    // Сначала — не потерял ли сам разбор кусок текста. Если потерял, всё
    // остальное в этом модуле проверено не полностью, и молчать об этом нельзя.
    for (const s of poteryano) {
      skazat("ОШИБКА", mod.slug, `разбор урока не увидел строку: ${s}`,
        "добавь поле в scripts/vidimoe.mts — иначе этот текст не проверяет никто");
    }

    for (const k of kuski) {
      if (/[а-яё]/i.test(k.text)) {
        proveritKalki(k);
        proveritProshedshee(k);
        proveritKratkoe(k);
        proveritPovelenie(k);
        proveritNazvaniya(k);
        proveritUnizhenie(k);
        proveritSchyot(k);
      }
      proveritZnaki(k);
    }
  }
}

if (slogovye.size) {
  skazat("СВЕДЕНИЯ", kursSlug ?? "весь курс",
    `записи с «ə» перед конечным l или n — ${slogovye.size} штук:\n   ` +
    [...slogovye].sort().join("  ") +
    "\n   Оценки здесь нет: в большинстве этих слов гласный на месте и по словарю.\n" +
    "   Смотри одно: не записано ли одно и то же слово в двух модулях по-разному.");
}

otchyot(
  "Это половина работы редактора — механическая. Понятность, тон и связность\n" +
  "машина не проверяет: за ними по-прежнему редактор."
);
