// Схема базы данных CodeNTalk v2.
// Соответствует разделу 8 документа docs/TZ-platform-v2.md.
//
// Главное разделение: таблицы учеников (их правим постоянно) и таблицы-зеркала
// учебных материалов (их заполняет скрипт из репозитория, руками не трогаем).

generator client {
  provider = "prisma-client"
  output   = "../lib/db/generated"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Ученики и доступ
// ---------------------------------------------------------------------------

enum Role {
  learner
  admin
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String?   @map("password_hash")
  displayName     String    @map("display_name")
  role            Role      @default(learner)
  emailVerifiedAt DateTime? @map("email_verified_at")

  // ответы на вопросы при регистрации: цель, время в неделю, интересы
  onboarding Json?

  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime? @map("last_seen_at")

  subscriptions    Subscription[]
  enrollments      Enrollment[]
  lessonProgress   LessonProgress[]
  courseProgress   CourseProgress[]
  certificates     Certificate[]
  accounts         Account[]
  sessions         Session[]
  exerciseAttempts ExerciseAttempt[]
  testAttempts     TestAttempt[]
  confusionMarks   ConfusionMark[]
  lessonNotes      LessonNote[]

  @@map("users")
}

// Таблицы для Auth.js. Сейчас вход только по почте и паролю, но вход через
// сторонние сервисы добавится позже — пусть его не придётся вводить миграцией.

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum SubscriptionPlan {
  free
  premium
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
}

/// Уровень доступа ВЫЧИСЛЯЕТСЯ отсюда и не дублируется полем у пользователя:
/// два источника правды неизбежно разойдутся (см. раздел 8.1 техзадания).
model Subscription {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan   SubscriptionPlan   @default(free)
  status SubscriptionStatus @default(active)

  // платёжная система спрятана за общим интерфейсом; в первой версии — заглушка
  provider           String  @default("stub")
  providerCustomerId String? @map("provider_customer_id")
  providerSubId      String? @map("provider_sub_id")

  currentPeriodStart DateTime? @map("current_period_start")
  currentPeriodEnd   DateTime? @map("current_period_end")
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, status])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Зеркало учебных материалов
// Заполняется скриптом из папки content/. Руками не редактируется.
// ---------------------------------------------------------------------------

model Track {
  id      String   @id @default(uuid()) @db.Uuid
  slug    String   @unique
  title   String
  kind    String // language | programming | profession
  sort    Int      @default(0)
  courses Course[]

  @@map("tracks")
}

enum CourseAccess {
  free
  premium
}

model Course {
  id      String @id @default(uuid()) @db.Uuid
  slug    String @unique
  trackId String @map("track_id") @db.Uuid
  track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)

  title  String
  level  String?
  access CourseAccess @default(premium)
  sort   Int          @default(0)

  isPublished Boolean @default(false) @map("is_published")

  modules        Module[]
  lessons        Lesson[]
  enrollments    Enrollment[]
  courseProgress CourseProgress[]
  certificates   Certificate[]
  tests          Test[]

  @@map("courses")
}

model Module {
  id       String @id @default(uuid()) @db.Uuid
  courseId String @map("course_id") @db.Uuid
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  slug  String
  title String
  sort  Int    @default(0)

  /// Чему учит модуль. Формулировки «умеет…», по ним сверяются вопросы проверочной.
  outcomes String[] @default([])

  /// Откуда взят материал. ВНУТРЕННЕЕ поле: ученику не показывается,
  /// нужно проверяющему и как доказательство, что содержание не сочинено.
  sources Json?

  lessons Lesson[]
  tests   Test[]

  @@unique([courseId, slug])
  @@map("modules")
}

model Lesson {
  id       String  @id @default(uuid()) @db.Uuid
  moduleId String? @map("module_id") @db.Uuid
  module   Module? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  courseId String  @map("course_id") @db.Uuid
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  slug  String
  title String
  kind  String @default("mixed") // theory | practice | mixed

  /// Одна проверяемая формулировка «умеет…». Скрипт проверок следит, чтобы у неё
  /// нашёлся вопрос в проверочной работе модуля.
  outcome String?

  estimatedMinutes Int? @map("estimated_minutes")

  /// Задел под открытие материалов по расписанию. Пусто = доступен сразу.
  availableAt DateTime? @map("available_at")

  sort Int @default(0)

  progress       LessonProgress[]
  exercises      Exercise[]
  confusionMarks ConfusionMark[]
  notes          LessonNote[]

  @@unique([courseId, slug])
  @@map("lessons")
}

/**
 * Пометка «непонятно» на блоке урока.
 * Ученику это список мест, куда он собирался вернуться. Владельцу — приборная
 * панель качества уроков: если один и тот же абзац помечает половина учеников,
 * плох абзац, а не ученики. Ради этого стоит второй указатель по уроку и блоку.
 * Пометка привязана к ИМЕНИ блока, а не к его номеру: переставленные абзацы
 * не должны молча уносить пометки на чужие места.
 */
model ConfusionMark {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lessonId String @map("lesson_id") @db.Uuid
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  blockId String @map("block_id")

  /// Что именно неясно, словами. Необязательно: нажать должно быть можно молча.
  comment String?

  /// Заполнено — ученик вернулся и разобрался.
  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@unique([userId, lessonId, blockId])
  @@index([lessonId, blockId])
  @@map("confusion_marks")
}

/// Заметка ученика к уроку. Одна на урок, а не россыпь листков поверх текста:
/// плавающие заметки мешают на телефоне и программам чтения с экрана.
model LessonNote {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lessonId String @map("lesson_id") @db.Uuid
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  text      String
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, lessonId])
  @@map("lesson_notes")
}

// ---------------------------------------------------------------------------
// Обучение
// ---------------------------------------------------------------------------

/// Занятое место из двух возможных. Бесплатные курсы места НЕ занимают —
/// проверка живёт в lib/domain/enrollment.ts, а не в базе.
model Enrollment {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId String @map("course_id") @db.Uuid
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  /// Первое число месяца, за который занято место
  periodMonth DateTime @map("period_month") @db.Date

  activatedAt DateTime  @default(now()) @map("activated_at")
  /// Заполнено => курс пройден и место освобождено досрочно
  completedAt DateTime? @map("completed_at")

  @@unique([userId, courseId, periodMonth])
  @@index([userId, periodMonth])
  @@map("enrollments")
}

enum ProgressStatus {
  in_progress
  completed
}

model LessonProgress {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lessonId String @map("lesson_id") @db.Uuid
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  status ProgressStatus @default(in_progress)

  /// Где именно ученик остановился внутри урока — чтобы вернуть его на то же место
  position Json?

  completedAt DateTime? @map("completed_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

/// Заранее посчитанные итоги — чтобы личный кабинет не пересчитывал всё каждый раз.
model CourseProgress {
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId String @map("course_id") @db.Uuid
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessonsCompleted Int     @default(0) @map("lessons_completed")
  lessonsTotal     Int     @default(0) @map("lessons_total")
  lastLessonId     String? @map("last_lesson_id") @db.Uuid

  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([userId, courseId])
  @@map("course_progress")
}

// ---------------------------------------------------------------------------
// Проверка знаний
//
// Упражнения и проверочные работы — разное по назначению (раздел 5.3
// техзадания): упражнения учат и на оценку не влияют, проверочные оценивают.
// ---------------------------------------------------------------------------

model Exercise {
  id       String @id @default(uuid()) @db.Uuid
  lessonId String @map("lesson_id") @db.Uuid
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  kind    String // choice | fill | assemble | listen | code
  payload Json // варианты, ответ, подсказка — форма зависит от вида
  sort    Int    @default(0)

  attempts ExerciseAttempt[]

  @@map("exercises")
}

model ExerciseAttempt {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  exerciseId String   @map("exercise_id") @db.Uuid
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  answer    Json
  isCorrect Boolean  @map("is_correct")
  hintsUsed Int      @default(0) @map("hints_used")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, exerciseId])
  @@map("exercise_attempts")
}

enum TestKind {
  module_quiz
  final_exam
}

model Test {
  id       String  @id @default(uuid()) @db.Uuid
  courseId String  @map("course_id") @db.Uuid
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId String? @map("module_id") @db.Uuid
  module   Module? @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  kind  TestKind
  title String

  /// Сколько вопросов показываем из банка — вторая попытка даёт другие
  questionsPerAttempt Int  @default(10) @map("questions_per_attempt")
  passScore           Int  @default(70) @map("pass_score")
  timeLimitMinutes    Int? @map("time_limit_minutes")
  maxAttemptsPerDay   Int? @map("max_attempts_per_day")

  questions TestQuestion[]
  attempts  TestAttempt[]

  @@map("tests")
}

model TestQuestion {
  id     String @id @default(uuid()) @db.Uuid
  testId String @map("test_id") @db.Uuid
  test   Test   @relation(fields: [testId], references: [id], onDelete: Cascade)

  kind String // choice | fill | order | match

  /// Текст вопроса, варианты и правильный ответ.
  /// НАРУЖУ ответ не отдаётся до сдачи попытки — см. раздел 10 техзадания.
  payload Json

  /// Тема вопроса: по ней собирается разбор «слабые места»
  topic      String?
  difficulty Int     @default(1)

  @@index([testId])
  @@map("test_questions")
}

model TestAttempt {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  testId String @map("test_id") @db.Uuid
  test   Test   @relation(fields: [testId], references: [id], onDelete: Cascade)

  /// Выборка вопросов закрепляется за попыткой: при обновлении страницы
  /// ученик должен увидеть те же вопросы, а не новые
  questionIds String[] @map("question_ids") @db.Uuid

  answers Json

  score  Int?
  passed Boolean?

  startedAt   DateTime  @default(now()) @map("started_at")
  submittedAt DateTime? @map("submitted_at")

  @@index([userId, testId, startedAt])
  @@map("test_attempts")
}

// ---------------------------------------------------------------------------
// Сертификаты
// ---------------------------------------------------------------------------

model Certificate {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId String @map("course_id") @db.Uuid
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  /// Публичный код для проверки подлинности без входа в аккаунт
  serial String @unique

  finalScore Int?      @map("final_score")
  issuedAt   DateTime  @default(now()) @map("issued_at")
  pdfKey     String?   @map("pdf_key")
  revokedAt  DateTime? @map("revoked_at")

  @@map("certificates")
}
